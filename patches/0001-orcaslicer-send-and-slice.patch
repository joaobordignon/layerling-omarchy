+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+
+/**
+ * Embedding hosts (protocol v1): an app that shows the editor in an iframe,
+ * such as a slicer's plugin tab, can take the design straight from it instead
+ * of the user exporting a file and importing it again.
+ *
+ * Only the window that frames this page is listened to, and nothing is sent
+ * until it has said who it is:
+ *
+ *   editor -> host   { type: "layerling:hello", version }            on mount, so a host that loaded first hears it
+ *   host -> editor   { type: "layerling:host", version, name, format? }   "OrcaSlicer", format "3mf" | "stl"
+ *   editor -> host   { type: "layerling:ready", version }
+ *   host -> editor   { type: "layerling:request-model", requestId?, format? }   the host's own button, if it has one
+ *   editor -> host   { type: "layerling:model", version, requestId?, fileName, format, bytes, base64 }
+ *   editor -> host   { type: "layerling:error", version, requestId?, message }
+ *
+ * Once a host has introduced itself the editor shows a "Send to <name>" button;
+ * the file is the one the export window writes (export_mesh).
+ */
+export const HOST_PROTOCOL_VERSION = 1;
+
+export type HostExportFormat = "3mf" | "stl";
+export type HostExportResult = { fileName: string; format: string; bytes: number; base64: string };
+
+type Host = { name: string; format: HostExportFormat; origin: string };
+type Phase = { kind: "idle" } | { kind: "sending" } | { kind: "sent" } | { kind: "failed"; message: string };
+
+const HOST_NAME_MAX = 40;
+
+function framingWindow(): Window | null {
+  if (typeof window === "undefined" || window.parent === window) return null;
+  return window.parent;
+}
+
+export function HostSendButton({ exportModel }: { exportModel: (format: HostExportFormat) => Promise<HostExportResult> }) {
+  const [host, setHost] = useState<Host | null>(null);
+  const [phase, setPhase] = useState<Phase>({ kind: "idle" });
+  const hostRef = useRef<Host | null>(null);
+  const exportRef = useRef(exportModel);
+  exportRef.current = exportModel;
+
+  const post = useCallback((message: Record<string, unknown>) => {
+    const parent = framingWindow();
+    const current = hostRef.current;
+    if (!parent || !current) return;
+    // A host page built from a string (a plugin tab) has the opaque origin "null", which postMessage cannot target.
+    parent.postMessage({ ...message, version: HOST_PROTOCOL_VERSION }, current.origin === "null" ? "*" : current.origin);
+  }, []);
+
+  const send = useCallback(async (format?: HostExportFormat, requestId?: unknown) => {
+    const current = hostRef.current;
+    if (!current) return;
+    setPhase({ kind: "sending" });
+    try {
+      const result = await exportRef.current(format ?? current.format);
+      post({ type: "layerling:model", requestId, fileName: result.fileName, format: result.format, bytes: result.bytes, base64: result.base64 });
+      setPhase({ kind: "sent" });
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      post({ type: "layerling:error", requestId, message });
+      setPhase({ kind: "failed", message });
+    }
+  }, [post]);
+
+  useEffect(() => {
+    const parent = framingWindow();
+    if (!parent) return;
+    const onMessage = (event: MessageEvent) => {
+      if (event.source !== parent || !event.data || typeof event.data !== "object") return;
+      const data = event.data as Record<string, unknown>;
+      if (data.type === "layerling:host" && typeof data.name === "string" && data.name.trim()) {
+        const next: Host = {
+          name: data.name.trim().slice(0, HOST_NAME_MAX),
+          format: data.format === "stl" ? "stl" : "3mf",
+          origin: event.origin,
+        };
+        hostRef.current = next;
+        setHost(next);
+        post({ type: "layerling:ready" });
+      } else if (data.type === "layerling:request-model" && hostRef.current) {
+        void send(data.format === "stl" || data.format === "3mf" ? data.format : undefined, data.requestId);
+      }
+    };
+    window.addEventListener("message", onMessage);
+    // Says nothing about the design: only that an editor is here to be introduced to.
+    parent.postMessage({ type: "layerling:hello", version: HOST_PROTOCOL_VERSION }, "*");
+    return () => window.removeEventListener("message", onMessage);
+  }, [post, send]);
+
+  useEffect(() => {
+    if (phase.kind !== "sent" && phase.kind !== "failed") return;
+    const timer = window.setTimeout(() => setPhase({ kind: "idle" }), phase.kind === "sent" ? 2500 : 6000);
+    return () => window.clearTimeout(timer);
+  }, [phase]);
+
+  if (!host) return null;
+  const label = phase.kind === "sending" ? `Sending to ${host.name}…`
+    : phase.kind === "sent" ? `Sent to ${host.name} ✓`
+    : phase.kind === "failed" ? `Not sent: ${phase.message}`
+    : `Send to ${host.name}`;
+  return (
+    <button
+      type="button"
+      className="host-send-button"
+      onClick={() => void send()}
+      disabled={phase.kind === "sending"}
+      title={`Put this design on ${host.name}'s plate (${host.format.toUpperCase()}, as the export window writes it)`}
+      style={{
+        // Bottom left, above the status bar: the inspector panel takes the right side once a shape is selected.
+        position: "fixed", left: 56, bottom: 44, zIndex: 60, maxWidth: "min(420px, calc(100vw - 32px))",
+        padding: "10px 18px", borderRadius: 999, border: "none", cursor: phase.kind === "sending" ? "progress" : "pointer",
+        font: "600 14px/1.2 system-ui, sans-serif", color: "#1a1a1a",
+        background: phase.kind === "failed" ? "#ff8a80" : phase.kind === "sent" ? "#8be28b" : "#ff9f1c",
+        boxShadow: "0 4px 14px rgba(0,0,0,.25)", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap",
+      }}
+    >
+      {label}
+    </button>
+  );
+}
